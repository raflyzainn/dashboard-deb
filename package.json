{
  "name": "dashboard-deb",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": "22.x"
  },
  "scripts": {
    "dev": "vite dev --host 127.0.0.1",
    "build": "vite build",
    "preview": "vite preview --host 127.0.0.1",
    "prepare": "svelte-kit sync",
    "check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
    "test": "tsx --test tests/*.test.ts",
    "test:e2e": "playwright test",
    "pb:setup": "tsx scripts/pocketbase/cli.ts setup",
    "pb:serve": "tsx scripts/pocketbase/cli.ts serve",
    "pb:preview": "tsx scripts/pocketbase/cli.ts preview",
    "pb:migrate": "tsx scripts/pocketbase/cli.ts migrate",
    "pb:seed": "tsx scripts/pocketbase/cli.ts seed",
    "pb:account": "tsx scripts/pocketbase/cli.ts account",
    "test:pb": "tsx --test --test-concurrency=1 tests/pocketbase/*.test.ts"
  },
  "dependencies": {
    "@fontsource-variable/plus-jakarta-sans": "^5.3.0",
    "diff": "^9.0.0",
    "pdfjs-dist": "^6.3.289",
    "pocketbase": "0.28.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.58.0",
    "@sveltejs/adapter-vercel": "^6.3.4",
    "@sveltejs/kit": "^2.49.1",
    "@sveltejs/vite-plugin-svelte": "^6.2.1",
    "@tailwindcss/vite": "^4.1.17",
    "@types/node": "^25.0.0",
    "svelte": "^5.45.6",
    "svelte-check": "^4.3.0",
    "tailwindcss": "^4.1.17",
    "tsx": "^4.21.0",
    "typescript": "^5.9.3",
    "vite": "^7.2.6"
  }
}
