# Server only. Preview identities are allowed only on a loopback dev server.
PB_URL=http://127.0.0.1:8096
DEB_LOCAL_PREVIEW_ENABLED=true
# Optional isolated QA directory (under .local/pocketbase/tests).
# DEB_LOCAL_INSTANCE_DIR=
PB_SUPERUSER_EMAIL=
PB_SUPERUSER_PASSWORD=

# All following variables belong to SvelteKit, not the PocketBase process.
# Production: HTTPS origin without trailing slash; disable local preview above.
DEB_PUBLIC_URL=http://127.0.0.1:5176
# Random secret >=32 characters; stable across all instances/deployments.
# Local QA reads the generated secret from its marked instance directory.
DEB_INVITATION_KEY=

# Email credentials belong only in PocketBase Settings > Mail settings.
# No SMTP_*, POSTMARK_*, DEB_MAIL_MODE or CRON_SECRET env is needed by SvelteKit.
# Never expose secrets through VITE_* or PUBLIC_* variables.
