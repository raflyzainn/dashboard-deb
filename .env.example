# Server only. Preview identities are allowed only on a loopback dev server.
PB_URL=http://127.0.0.1:8096
DEB_LOCAL_PREVIEW_ENABLED=true
# Optional isolated QA directory (under .local/pocketbase/tests).
# DEB_LOCAL_INSTANCE_DIR=
PB_SUPERUSER_EMAIL=
PB_SUPERUSER_PASSWORD=

# TODO(P1-SMTP): configure PocketBase Settings > Mail settings before real delivery:
# SMTP host, port, TLS, username/password, sender name/address (secrets stay outside Git).
# DEB_MAIL_MODE=external and DEB_PUBLIC_URL=https://your-real-domain must be set
# in the PocketBase process environment. Local helper defaults to loopback Mailpit.
# DEB_INVITATION_KEY: random secret >=32 characters, server only; generated locally by pb:serve.
# SMTP credentials must never be exposed through VITE_* or PUBLIC_* variables.
